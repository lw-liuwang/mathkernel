{
  "schema_version": 1,
  "name": "matrix-chain-workflow",
  "specification": {
    "description": "Compute Y = (AB)C; optimize association and output-stationary tiles.",
    "inputs": [
      {
        "name": "A",
        "shape": "1024 x 64",
        "domain": "real matrices"
      },
      {
        "name": "B",
        "shape": "64 x 1024",
        "domain": "real matrices"
      },
      {
        "name": "C",
        "shape": "1024 x 64",
        "domain": "real matrices"
      }
    ],
    "outputs": [
      {
        "name": "Y",
        "shape": "1024 x 64",
        "domain": "real matrices"
      }
    ],
    "semantics": "Exact real arithmetic; element_bytes counts traffic, not floating-point rounding.",
    "conditions": [
      "All inputs and final outputs reside in slow memory.",
      "Sequential GEMMs; intermediate results are fully materialized.",
      "Each GEMM dimension must be exactly divisible by the shared tile sizes."
    ]
  },
  "hardware": {
    "name": "synthetic-100tflops-1tbps",
    "peak_flops_per_second": 100000000000000,
    "hbm_bytes_per_second": 1000000000000,
    "fast_memory_bytes": 49152,
    "element_bytes": 4
  },
  "model": {
    "kind": "matmul-chain",
    "definition": "model/task.json"
  },
  "baseline": {
    "order": "left",
    "tile": {
      "m": 64,
      "n": 64,
      "k": 64
    }
  },
  "objective": {
    "metric": "estimated_seconds",
    "minimum_reduction": {
      "numerator": 0,
      "denominator": 1
    }
  },
  "constraints": {},
  "budget": {
    "max_iterations": 10,
    "max_seconds": 600
  },
  "supplements": []
}
